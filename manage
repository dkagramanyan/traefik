#!/bin/sh
set -eu
cd "$(dirname "$0")"
if ! .venv/bin/python -c 'import yaml, bcrypt' 2>/dev/null; then
    python3 -m venv .venv
    .venv/bin/pip install -q -r requirements.txt
fi
operation=${1:-up}
if [ "$#" -gt 0 ]; then shift; fi
case "$operation" in
    setup) exec .venv/bin/python scripts/setup.py "$@" ;;
    adopt) exec .venv/bin/python scripts/adopt.py "$@" ;;
    up)
        .venv/bin/python scripts/setup.py --quiet
        exec docker compose up -d --build "$@"
        ;;
    *) exec docker compose "$operation" "$@" ;;
esac
