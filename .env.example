# ./manage setup imports existing values, derives hostnames and fills local secrets.
# Never commit .env. Existing DNS-provider credentials are preserved.
DOMAIN=
ACME_EMAIL=
ACME_DNS_PROVIDER=selectelv2
ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
ACME_DNS_DELAY=20s
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_STORAGE_DIR=./letsencrypt
CERTIFICATES_DIR=./certs
# Supply your provider credentials; setup cannot obtain these from the provider.
SELECTELV2_ACCOUNT_ID=
SELECTELV2_PROJECT_ID=
SELECTELV2_USERNAME=
SELECTELV2_PASSWORD=

COMPOSE_PROJECT_NAME=traefik
TRAEFIK_NETWORK=proxy
# Optional legacy hostname mapping, imported from existing Compose extra_hosts.
BACKEND_HOST_ALIAS=legacy-gateway
BACKEND_HOST_ADDRESS=127.0.0.1
TRAEFIK_IMAGE=traefik:v3.7.15
TRAEFIK_CONTAINER_NAME=traefik
TRAEFIK_LOG_LEVEL=INFO
LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
APPLE_RELAY_PORT=8443
# Dashboard password/hash are generated once if no existing hash was imported.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_AUTH=
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_CONTAINER_NAME=grafana
GRAFANA_ADMIN_PASSWORD=
# Comma-separated networks allowed to access private websites.
TRUSTED_CIDRS=127.0.0.1/32,::1/128
# Network values below come from the OpenVPN UI's gateway file (./manage setup --network-file).
# Guest portal listener: allowed sources (the OpenVPN server; empty = TRUSTED_CIDRS) and address.
PORTAL_CIDRS=
PORTAL_LISTEN_ADDRESS=127.0.0.1
PORTAL_HTTPS_PORT=9443
SERVICE_ROUTES_JSON=[]
# Guest links from the gateway file: [{"host", "path"}] guests may open through the portal listener.
GUEST_LINKS_JSON=[]

# Hostnames and relay URL are derived from DOMAIN when empty.
OPENVPN_HOST=
# Derived value to copy into the OpenVPN server environment.
OVPN_RELAY_SIGNER_URL=
APPLE_RELAY_HOST=
APPLE_RELAY_URL=
APPLE_RELAY_BACKEND=host.docker.internal:8444
SIGNER_SOURCE_CIDRS=
COMPOSE_PROFILES=profile-signing
RELAY_PROFILE_SIGNING_TOKEN=
PROFILE_SIGNER_SOURCE=https://github.com/dkagramanyan/openvpn-server.git#ffd1ef79c1a29294607ca52424d4216744db92b1

# Core backend only. Additional services are entered in the UI, never committed.
BACKEND_OPENVPN=http://host.docker.internal:8080
# JSON array of certFile/keyFile objects, referring to files under /certs.
EXTRA_TLS_CERTIFICATES=[]

# Optional forwarding worker. Set the URL later, then run ./manage up.
# Example: https://prometheus.example.com/api/v1/write
METRICS_REMOTE_WRITE_URL=
METRICS_USERNAME=
METRICS_PASSWORD=
METRICS_BEARER_TOKEN=
METRICS_INSTANCE=
METRICS_AGENT_IMAGE=prom/prometheus:v3.13.3
LOCAL_UID=
LOCAL_GID=
