# Merge into the existing .env on the Pi; never replace DNS-provider credentials.
COMPOSE_PROJECT_NAME=traefik
DOMAIN=dgkagramanyan.ru
# Preserve the existing username/password hash. Quote hashes containing $ in .env.
DASHBOARD_AUTH=
# Move the existing Compose password here. Existing Grafana users manage it in Grafana.
GRAFANA_ADMIN_PASSWORD=
# Keep your existing SelectelV2 environment variables here, with their current names.

# Optional automatic .mobileconfig signing: enable after setting the shared token.
# COMPOSE_PROFILES=profile-signing
RELAY_PROFILE_SIGNING_TOKEN=
# The signer is built directly from this pinned public source; no extra clone is needed.
PROFILE_SIGNER_SOURCE=https://github.com/dkagramanyan/openvpn-server.git#562790a32953c91fb88799e673002c72fafdd994
